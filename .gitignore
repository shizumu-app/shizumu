# dependencies
node_modules/

# build output
dist/
dist-demo/

# tauri build (handled by src-tauri/.gitignore too)
src-tauri/target/
# The whole gen/ tree is generated, never committed. gen/android/ is
# regenerated by `npx tauri android init` on every CI build (see the
# build-android job) and reaches ~1GB once gradle has run — bump-version.sh
# ends with `git add -A`, so without this it lands in a release commit.
src-tauri/gen/

# keystores / signing material
# *.pem / *.p12 matter as much as the keystores: upload_certificate.pem sat
# here untracked but UNIGNORED, and bump-version.sh ends in `git add -A`, so a
# release run would have committed the play upload certificate.
*.jks
*.keystore
*.pem
*.p12

# python bytecode from scripts/
__pycache__/
*.pyc

# root-owned build output left behind by containerised VR runs
dist.root-owned-*/

# environment & secrets
.env
.env.*
!.env.example

# editor / ide
.vscode/
.idea/
*.swp
*.swo
*~

# os files
.DS_Store
Thumbs.db

# claude code
.claude/

# local working dirs
flahub/

# git worktrees (used for parallel feature branches)
.worktrees/

# marketing screenshots (raw captures, not the ones served via pages)
# launch/site/screenshots/ is committed — served via gitlab pages for flathub metainfo

# flatpak build artifacts
.flatpak-builder/
flatpak-dist/
*.flatpak

# flathub shared-modules — cloned locally for flatpak-builder testing only.
# on the flathub PR side, shared-modules is a git submodule of flathub/flathub
# so the same "shared-modules/..." path in the manifest resolves there too.
flatpak/shared-modules/
flatpak/build-dir/
flatpak/.flatpak-builder/

# debug logs
*.log
npm-debug.log*

# kamae runtime build artifacts (Rust target dir is ~1GB)
skills/kamae/runtime/target/

# kamae per-project locks (advisory file locks; not portable across machines)
.kamae/locks/

# kamae internal state
.kamae/
.kamae.archive/
.superpowers/

# kamae lineage index (cache, regenerable via `kamae lineage --rebuild`)
.kamae/lineage/

# kamae feedback session tree snapshots (large; rebuildable from events.jsonl)
.kamae/feedback/*/tree-snapshots/

# superpowers brainstorming sessions (local UI state; ephemeral)
.superpowers/

# VR test output (baselines under tests/vr/baselines ARE committed)
/test-results/
/playwright-report/

# VR Tier-2 capture output (baselines under e2e/vr/baselines ARE committed)
/e2e/vr/out/
# kamae runtime state — per-project run logs, mutation journals.
# Commit only the canon (kamae.md + skills/) and the long-lived state
# nodes you want versioned.
.kamae/state/runs/
.kamae/state/locks/
