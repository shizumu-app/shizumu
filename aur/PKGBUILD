pkgname=shizumu
pkgver=0.6.0
pkgrel=1
pkgdesc="write to think. pin what matters. the rest sinks. a private thinking space — no tags, no folders, no prompts."
arch=('x86_64')
url="https://shizumu.app"
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3')
source=("https://shizumu.app/downloads/shizumu-0.6.0-linux-x86_64.tar.gz")
sha256sums=('53a8ed115d034b825eb6951dc54cbb9b5dc569b8418b6c96cc8cda19575d0283')

package() {
  install -Dm755 "${srcdir}/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/${pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
}
