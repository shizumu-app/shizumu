# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# CLI binary copied here during CI build for bundling
/resources/shizumu-cli
/resources/shizumu-cli.exe

# Android release signing — keystore + creds must never enter git.
# Keystore is sourced from CI env vars in pipelines, or from
# keystore.properties (also ignored) for local release builds.
/gen/android/app/keystore.properties
/gen/android/keystore.properties
*.jks
*.keystore
